.venv-tts/
.venv-stt/
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep
samples/reference.wav
samples/reference.txt
samples/stt_ru.wav
# Refs #57: registered voice references (encoded codes + transcript, docs/guides/
# audiobook_guide.md sec. 2/2a) -- derived from generated/user audio, regenerated on demand
# via --save-voice-as or register_voice(), never committed (same policy as samples/reference.*).
voices/
# Исходные записи для эталона: пользовательское аудио в Git не хранится.
samples/*.m4a
samples/*.mp3
samples/*.flac
samples/*.ogg
*.pyc
__pycache__/
.hf-helper-cache/
.DS_Store

# Issue #57 (Mojo/MAX research): изолированные окружения pixi с Mojo/MAX.
# ~1.9 ГБ на окружение — скачанные бинарники в Git не хранятся.
.mojo-probe/
.mojo-probe-stable/
# Официальные skills Modular (issue #57), поставленные через `npx skills add
# modular/skills`. Сам вендоренный контент регенерируется из skills-lock.json
# (см. корень репозитория) командой `npx skills experimental_install` — лок-файл
# коммитится, а .agents/.claude/skills — нет, по аналогии с node_modules.
.agents/
.claude/*
!.claude/skills/
.claude/skills/*
# issue #114: audiobook-markup is this project's own authored skill (the DSL spec),
# not vendored via npx skills add -- it is committed, unlike the rest of .claude/skills.
!.claude/skills/audiobook-markup/
# Scratch clones of vllm-omni/modular used for M1 fact-extraction research —
# large, reproducible from their pinned refs, never committed.
.research-scratch/
# M3-6 (issue #57): real-checkpoint weight cache (.venv-tts-only extraction, plain FP32 .npz,
# ~11MB) regenerated on demand by m3_real_weights_export.py / m3_decoder_block_prototype.py
# --real-weights -- derived from the checkpoint, not source, never committed.
docs/research/mojo-max/.m3_real_weights_block1.npz
